BootStrap: docker
From: docker.elastic.co/elasticsearch/elasticsearch:7.10.0

%environment
    export ES_JAVA_OPTS="-Xms512m -Xmx512m"

%post
    apt-get update && apt-get install -y \
        openjdk-11-jdk \
        && rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/share/elasticsearch/bin/elasticsearch
